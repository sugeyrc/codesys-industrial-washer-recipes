          <data name="http://www.3s-software.com/plcopenxml/pou" handleUnknown="implementation">
            <pou name="PLC_PRG" pouType="program">
              <interface>
                <localVars>
                  <variable name="Btn_Prog_1">
                    <type>
                      <BOOL />
                    </type>
                    <documentation>
                      <xhtml xmlns="http://www.w3.org/1999/xhtml">Botones he indicadores (HMI)</xhtml>
                    </documentation>
                  </variable>
                  <variable name="Btn_Prog_2">
                    <type>
                      <BOOL />
                    </type>
                  </variable>
                  <variable name="Btn_Iniciar">
                    <type>
                      <BOOL />
                    </type>
                  </variable>
                  <variable name="Paro_Emergencia">
                    <type>
                      <BOOL />
                    </type>
                  </variable>
                  <variable name="Falla_Tambor">
                    <type>
                      <BOOL />
                    </type>
                  </variable>
                  <variable name="Sensor_Temperatura_Crudo">
                    <type>
                      <INT />
                    </type>
                    <documentation>
                      <xhtml xmlns="http://www.w3.org/1999/xhtml">DESLIZADOR</xhtml>
                    </documentation>
                  </variable>
                  <variable name="Recetas">
                    <type>
                      <array>
                        <dimension lower="1" upper="2" />
                        <baseType>
                          <derived name="ST_CicloLavado" />
                        </baseType>
                      </array>
                    </type>
                    <documentation>
                      <xhtml xmlns="http://www.w3.org/1999/xhtml">Recetas</xhtml>
                    </documentation>
                  </variable>
                  <variable name="Receta_Activa">
                    <type>
                      <derived name="ST_CicloLavado" />
                    </type>
                  </variable>
                  <variable name="Tambor">
                    <type>
                      <derived name="FB_Tambor" />
                    </type>
                    <documentation>
                      <xhtml xmlns="http://www.w3.org/1999/xhtml">Control</xhtml>
                    </documentation>
                  </variable>
                  <variable name="Reloj_Proceso">
                    <type>
                      <derived name="TON" />
                    </type>
                  </variable>
                  <variable name="Estado">
                    <type>
                      <INT />
                    </type>
                    <initialValue>
                      <simpleValue value="0" />
                    </initialValue>
                  </variable>
                  <variable name="Valvula_Agua">
                    <type>
                      <BOOL />
                    </type>
                    <documentation>
                      <xhtml xmlns="http://www.w3.org/1999/xhtml">Lecturas</xhtml>
                    </documentation>
                  </variable>
                  <variable name="Valvula_Desague">
                    <type>
                      <BOOL />
                    </type>
                  </variable>
                  <variable name="Calentador">
                    <type>
                      <BOOL />
                    </type>
                  </variable>
                  <variable name="Ciclo_Terminado">
                    <type>
                      <BOOL />
                    </type>
                  </variable>
                  <variable name="Luz_Emergencia">
                    <type>
                      <BOOL />
                    </type>
                  </variable>
                  <variable name="Temp_Actual">
                    <type>
                      <REAL />
                    </type>
                  </variable>
                </localVars>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Temp_Actual := Escalar(
	Entrada_Cruda := Sensor_Temperatura_Crudo,
	Crudo_Min := 0,
	Crudo_Max := 27648,
	Escala_Min := 0.0,
	Escala_Max := 100.0
);

IF Paro_Emergencia OR Tambor.Alarma_Motor THEN
	Estado := 99;
END_IF;

CASE Estado OF
	0: //Reposo
	  Valvula_Agua := FALSE;
	  Calentador := FALSE;
	  Valvula_Desague := FALSE;
	  Tambor.Girar := FALSE;
	  Ciclo_Terminado := FALSE;
	  Luz_Emergencia := FALSE;
	  Reloj_Proceso(IN := FALSE);
	 
	 IF Btn_Prog_1 THEN
		 Receta_Activa.Nombre := 'Ropa Delicada';
		 Receta_Activa.Temp_Objetivo := 30.0;
		 Receta_Activa.Tiempo_Lavado := T#4S;
		 Receta_Activa.Tiempo_Enjuague := T#3S;
     ELSIF Btn_Prog_2 THEN
		 Receta_Activa.Nombre := 'Ropa Pesada';
		 Receta_Activa.Temp_Objetivo := 60.0;
		 Receta_Activa.Tiempo_Lavado := T#6S;
		 Receta_Activa.Tiempo_Enjuague := T#4S;
	 END_IF;
	 
	 IF Btn_Iniciar AND (Receta_Activa.Temp_Objetivo &gt; 0.0) THEN
	       Estado := 10;
	 END_IF;
	  
	10:  //Llenado
	   Valvula_Agua := TRUE;
	   Reloj_Proceso(IN := TRUE, PT := T#3S);
	   IF Reloj_Proceso.Q THEN
		   Reloj_Proceso(IN := FALSE);
           Valvula_Agua := FALSE;
           Estado := 20;
	   END_IF;
	   
	20:  //Calentamiento
	   Valvula_Agua := FALSE;
	   Calentador := TRUE;
	   IF Temp_Actual &gt;= Receta_Activa.Temp_Objetivo THEN
		   Calentador := FALSE;
		   Estado := 30;
	   END_IF;
	   
	30:  //Lavado
	   Tambor.Girar := TRUE;
	   Reloj_Proceso(IN := TRUE, PT := Receta_Activa.Tiempo_Lavado);
	   IF  Reloj_Proceso.Q THEN
		   Reloj_Proceso(IN := FALSE);
		   Tambor.Girar := FALSE;
		   Estado := 40;
	   END_IF;
	40:  //Drenaje
	   Valvula_Desague := TRUE;
	   Reloj_Proceso(IN := TRUE, PT := T#2S);
	   IF Reloj_Proceso.Q THEN
		   Reloj_Proceso(IN := FALSE);
		   Valvula_Desague := FALSE;
		   Estado := 50;
	   END_IF;
	50:  // Enjuage
	   Valvula_Agua := TRUE;
	   Tambor.Girar := TRUE;
	   Reloj_Proceso(IN := TRUE, PT := Receta_Activa.Tiempo_Enjuague);
	   IF Reloj_Proceso.Q THEN
		   Valvula_Agua := FALSE;
	       Tambor.Girar := FALSE;
		   Reloj_Proceso(IN := FALSE);
		   Estado := 60;
	   END_IF;
	60:  //Terminado
	   Ciclo_Terminado := TRUE;
	   IF Btn_Iniciar THEN
		   Ciclo_Terminado := FALSE;
		   Estado := 0;
	   END_IF;
	99: // ESTADO 99: PARO DE EMERGENCIA ENCLAVADO
		Luz_Emergencia := TRUE;
        Valvula_Agua := FALSE;
		Calentador := FALSE;
		Valvula_Desague := FALSE;
		Ciclo_Terminado := FALSE;
		Tambor.Girar := FALSE;
		// Solo sale de emergencia cuando sueltas el paro y presionas Inicio
		IF Btn_Iniciar AND NOT Paro_Emergencia AND NOT Tambor.Alarma_Motor THEN
			Luz_Emergencia := FALSE;
			Estado := 0;                // Regresa a reposo (y apaga la luz)
		END_IF;
	
END_CASE;

Tambor(Falla_Motor := Falla_Tambor);


	</xhtml>
                </ST>
              </body>
