          <data name="http://www.3s-software.com/plcopenxml/pou" handleUnknown="implementation">
            <pou name="Escalar" pouType="function">
              <interface>
                <returnType>
                  <REAL />
                </returnType>
                <inputVars>
                  <variable name="Entrada_Cruda">
                    <type>
                      <INT />
                    </type>
                  </variable>
                  <variable name="Crudo_Min">
                    <type>
                      <INT />
                    </type>
                  </variable>
                  <variable name="Crudo_Max">
                    <type>
                      <INT />
                    </type>
                  </variable>
                  <variable name="Escala_Min">
                    <type>
                      <REAL />
                    </type>
                  </variable>
                  <variable name="Escala_Max">
                    <type>
                      <REAL />
                    </type>
                  </variable>
                </inputVars>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">IF Crudo_Max = Crudo_Min THEN
	Escalar := 0.0;
ELSE
	Escalar := (INT_TO_REAL(Entrada_Cruda - Crudo_Min)/INT_TO_REAL(Crudo_Max - Crudo_Min))*(Escala_Max - Escala_Min) + Escala_Min;
END_IF</xhtml>
                </ST>
              </body>
              <addData>
                <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
                  <ObjectId>45bd2cc3-1abf-476c-90ca-51f6225b8af7</ObjectId>
                </data>
              </addData>
            </pou>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/pou" handleUnknown="implementation">
            <pou name="FB_Tambor" pouType="functionBlock">
              <interface>
                <inputVars>
                  <variable name="Girar">
                    <type>
                      <BOOL />
                    </type>
                  </variable>
                  <variable name="Falla_Motor">
                    <type>
                      <BOOL />
                    </type>
                  </variable>
                </inputVars>
                <outputVars>
                  <variable name="Motor_Activo">
                    <type>
                      <BOOL />
                    </type>
                  </variable>
                  <variable name="Alarma_Motor">
                    <type>
                      <BOOL />
                    </type>
                  </variable>
                </outputVars>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">IF Falla_Motor THEN
	Motor_Activo := FALSE;
	Alarma_Motor := TRUE;
ELSIF Girar AND NOT Falla_Motor THEN
	Motor_Activo := TRUE;
	Alarma_Motor := FALSE;
ELSE 
	Motor_Activo := FALSE;
	Alarma_Motor := FALSE;
END_IF</xhtml>
                </ST>
              </body>
